# ============================================
# ZYATRIA GLOBAL - VARIABLES D'ENVIRONNEMENT
# ============================================

# ==================
# CLOUDFLARE PAGES
# ==================
CF_PAGES=1
CF_PAGES_BRANCH=main
CF_PAGES_COMMIT_SHA=auto

# ==================
# WEBFLOW API
# ==================
WEBFLOW_API_HOST=https://api-cdn.webflow.com/v2
WEBFLOW_SITE_API_TOKEN=your_webflow_site_token_here
WEBFLOW_CMS_SITE_API_TOKEN=your_webflow_cms_token_here

# ==================
# MISTRAL AI
# ==================
MISTRAL_API_KEY=your_mistral_api_key_here

# ==================
# STRIPE
# ==================
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Liens de paiement Stripe (Payment Links)
STRIPE_LINK_STARTER_MONTHLY=https://buy.stripe.com/your_link_here
STRIPE_LINK_STARTER_YEARLY=https://buy.stripe.com/your_link_here
STRIPE_LINK_PROFESSIONAL_MONTHLY=https://buy.stripe.com/your_link_here
STRIPE_LINK_PROFESSIONAL_YEARLY=https://buy.stripe.com/your_link_here
STRIPE_LINK_ENTERPRISE_MONTHLY=https://buy.stripe.com/your_link_here
STRIPE_LINK_ENTERPRISE_YEARLY=https://buy.stripe.com/your_link_here

# ==================
# FORMSPREE
# ==================
FORMSPREE_FORM_ID=your_formspree_form_id_here
FORMSPREE_CONTACT_FORM_ID=your_contact_form_id_here
FORMSPREE_LEAD_QUALIFICATION_FORM_ID=your_lead_form_id_here

# ==================
# TWILIO (Voice Agent)
# ==================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# ==================
# CRM INTEGRATION
# ==================
CRM_API_KEY=your_crm_api_key_here
CRM_API_URL=https://your-crm-api.com

# ==================
# ANALYTICS
# ==================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
PLAUSIBLE_DOMAIN=zyatria.global

# ==================
# ENVIRONMENT
# ==================
NODE_ENV=production
ENVIRONMENT=production
