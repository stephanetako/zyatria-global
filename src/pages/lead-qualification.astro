---
import MainLayout from '../layouts/main.astro';
import LeadQualificationFormSimple from '../components/LeadQualificationFormSimple';

const seoData = {
  title: "Qualification de Lead - ZyatrIA Global",
  description: "Formulaire de qualification pour vos projets d'agents IA et d'automation",
  ogImage: "/og-image.svg"
};
---

<MainLayout 
  title={seoData.title}
  description={seoData.description}
  ogImage={seoData.ogImage}
>
  <div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      {/* Header */}
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          🚀 Démarrez votre projet d'IA
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Remplissez ce formulaire pour obtenir une consultation gratuite et un devis personnalisé sous 24h
        </p>
      </div>

      {/* Form */}
      <LeadQualificationFormSimple client:only="react" />

      {/* Additional Info */}
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="text-center p-6 bg-white rounded-lg shadow-md border border-gray-200">
          <div class="text-4xl mb-3">🚀</div>
          <h3 class="font-bold text-gray-900 mb-2">Déploiement rapide</h3>
          <p class="text-sm text-gray-600">
            Votre solution IA opérationnelle en 7-15 jours
          </p>
        </div>

        <div class="text-center p-6 bg-white rounded-lg shadow-md border border-gray-200">
          <div class="text-4xl mb-3">🌍</div>
          <h3 class="font-bold text-gray-900 mb-2">Support multilingue</h3>
          <p class="text-sm text-gray-600">
            Service disponible en FR, EN, ES, PT
          </p>
        </div>

        <div class="text-center p-6 bg-white rounded-lg shadow-md border border-gray-200">
          <div class="text-4xl mb-3">💼</div>
          <h3 class="font-bold text-gray-900 mb-2">Accompagnement complet</h3>
          <p class="text-sm text-gray-600">
            De la conception au déploiement et au-delà
          </p>
        </div>
      </div>

      {/* FAQ Section */}
      <div class="mt-12 bg-white rounded-lg shadow-md p-8 border border-gray-200">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">
          ❓ Questions fréquentes
        </h2>
        
        <div class="space-y-6 max-w-3xl mx-auto">
          <div class="border-l-4 border-primary pl-4">
            <h3 class="font-bold text-gray-900 mb-2">
              Combien de temps pour obtenir une réponse ?
            </h3>
            <p class="text-gray-600">
              Nous nous engageons à vous répondre sous 24h ouvrées avec une première analyse de vos besoins.
            </p>
          </div>

          <div class="border-l-4 border-primary pl-4">
            <h3 class="font-bold text-gray-900 mb-2">
              Mes informations sont-elles confidentielles ?
            </h3>
            <p class="text-gray-600">
              Absolument. Toutes vos données sont traitées de manière confidentielle et ne seront jamais partagées avec des tiers.
            </p>
          </div>

          <div class="border-l-4 border-primary pl-4">
            <h3 class="font-bold text-gray-900 mb-2">
              Puis-je modifier mon projet après l'envoi ?
            </h3>
            <p class="text-gray-600">
              Bien sûr ! Lors de notre premier échange, nous affinerons ensemble tous les détails de votre projet.
            </p>
          </div>

          <div class="border-l-4 border-primary pl-4">
            <h3 class="font-bold text-gray-900 mb-2">
              Y a-t-il des frais pour la consultation ?
            </h3>
            <p class="text-gray-600">
              Non, la première consultation et le devis sont entièrement gratuits et sans engagement.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  /* Smooth animations */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .max-w-5xl > * {
    animation: fadeIn 0.6s ease-out;
  }
</style>
