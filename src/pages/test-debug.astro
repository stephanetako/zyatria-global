---
import MainLayout from '../layouts/main.astro';
import AppWrapperDebug from '../components/AppWrapperDebug';
---

<MainLayout title="Test Debug - ZyatrIA">
  <AppWrapperDebug client:only="react" />
</MainLayout>

<script>
  console.log('✅ Page test-debug chargée');
  
  window.addEventListener('error', (e) => {
    console.error('❌ Erreur JavaScript:', e.error);
    document.body.innerHTML = `
      <div style="padding: 2rem; background: #fee; min-height: 100vh;">
        <h1 style="color: #c00; font-size: 2rem; margin-bottom: 1rem;">Erreur JavaScript Détectée</h1>
        <pre style="background: white; padding: 1rem; border-radius: 0.5rem; overflow: auto;">
${e.error?.stack || e.message}
        </pre>
      </div>
    `;
  });
</script>
</MainLayout>
