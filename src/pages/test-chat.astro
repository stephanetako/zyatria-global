---
import { baseUrl } from '../lib/base-url';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Test Chatbot Zyra - ZyatrIA Global</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Instrument Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: linear-gradient(135deg, #F5F1EB 0%, #E6DCD4 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 1200px;
      display: grid;
      grid-template-columns: 1fr 600px;
      gap: 32px;
      align-items: start;
    }

    .info-panel {
      background: white;
      padding: 32px;
      border-radius: 16px;
      box-shadow: 0 8px 24px rgba(55, 61, 54, 0.1);
    }

    .info-panel h1 {
      color: #373D36;
      font-size: 32px;
      margin-bottom: 16px;
    }

    .info-panel h2 {
      color: #007AFF;
      font-size: 20px;
      margin: 24px 0 12px 0;
    }

    .info-panel p {
      color: #373D36;
      line-height: 1.6;
      margin-bottom: 12px;
    }

    .info-panel ul {
      list-style: none;
      padding: 0;
    }

    .info-panel li {
      color: #373D36;
      padding: 8px 0;
      padding-left: 24px;
      position: relative;
    }

    .info-panel li:before {
      content: "✓";
      position: absolute;
      left: 0;
      color: #007AFF;
      font-weight: bold;
    }

    .badge {
      display: inline-block;
      padding: 4px 12px;
      background: #007AFF;
      color: white;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
      margin-left: 8px;
    }

    .chat-container {
      width: 100%;
      height: 700px;
      background: white;
      border-radius: 24px;
      box-shadow: 0 20px 60px rgba(55, 61, 54, 0.15);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .chat-header {
      background: linear-gradient(135deg, #007AFF 0%, #0051D5 100%);
      color: white;
      padding: 24px;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .avatar {
      width: 48px;
      height: 48px;
      background: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      flex-shrink: 0;
    }

    .header-info h3 {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .header-info p {
      font-size: 14px;
      opacity: 0.9;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      background: #4CAF50;
      border-radius: 50%;
      display: inline-block;
      animation: blink 2s infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    .chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      background: #F5F1EB;
    }

    .message {
      display: flex;
      gap: 12px;
      animation: slideIn 0.3s ease-out;
    }

    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .message.user {
      flex-direction: row-reverse;
    }

    .message-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #E6DCD4;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 18px;
    }

    .message.user .message-avatar {
      background: #007AFF;
      color: white;
    }

    .message-content {
      max-width: 70%;
      padding: 12px 16px;
      border-radius: 16px;
      background: white;
      color: #373D36;
      line-height: 1.5;
    }

    .message.user .message-content {
      background: #007AFF;
      color: white;
    }

    .typing-indicator {
      display: flex;
      gap: 4px;
      padding: 12px 16px;
    }

    .typing-indicator span {
      width: 8px;
      height: 8px;
      background: #007AFF;
      border-radius: 50%;
      animation: typing 1.4s infinite;
    }

    .typing-indicator span:nth-child(2) {
      animation-delay: 0.2s;
    }

    .typing-indicator span:nth-child(3) {
      animation-delay: 0.4s;
    }

    @keyframes typing {
      0%, 60%, 100% {
        transform: translateY(0);
        opacity: 0.7;
      }
      30% {
        transform: translateY(-10px);
        opacity: 1;
      }
    }

    .chat-input-container {
      padding: 20px;
      background: white;
      border-top: 1px solid #E6DCD4;
    }

    .chat-input-wrapper {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .chat-input {
      flex: 1;
      padding: 14px 18px;
      border: 2px solid #E6DCD4;
      border-radius: 12px;
      font-size: 15px;
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s;
    }

    .chat-input:focus {
      border-color: #007AFF;
    }

    .send-button {
      width: 48px;
      height: 48px;
      background: #007AFF;
      border: none;
      border-radius: 12px;
      color: white;
      font-size: 20px;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .send-button:hover {
      background: #0051D5;
      transform: scale(1.05);
    }

    .send-button:disabled {
      background: #E6DCD4;
      cursor: not-allowed;
      transform: scale(1);
    }

    .quick-actions {
      display: flex;
      gap: 8px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .quick-action {
      padding: 8px 14px;
      background: #F5F1EB;
      border: 1px solid #E6DCD4;
      border-radius: 20px;
      font-size: 13px;
      color: #373D36;
      cursor: pointer;
      transition: all 0.2s;
    }

    .quick-action:hover {
      background: #007AFF;
      color: white;
      border-color: #007AFF;
    }

    .back-link {
      display: inline-block;
      margin-top: 24px;
      padding: 12px 24px;
      background: #007AFF;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      transition: all 0.2s;
    }

    .back-link:hover {
      background: #0051D5;
      transform: translateY(-2px);
    }

    @media (max-width: 1024px) {
      .container {
        grid-template-columns: 1fr;
      }

      .chat-container {
        height: 600px;
      }
    }

    @media (max-width: 640px) {
      body {
        padding: 0;
      }

      .container {
        gap: 0;
      }

      .info-panel {
        border-radius: 0;
      }

      .chat-container {
        height: calc(100vh - 400px);
        border-radius: 0;
      }

      .message-content {
        max-width: 80%;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="info-panel">
      <h1>🤖 Testez Zyra</h1>
      <p>Zyra est notre assistante IA intelligente propulsée par <strong>Mistral AI</strong> et <strong>Claude</strong>.</p>

      <h2>🎯 Capacités</h2>
      <ul>
        <li>Réponses instantanées 24/7</li>
        <li>Connaissance approfondie de nos services</li>
        <li>Qualification intelligente des besoins</li>
        <li>Support multilingue (FR, EN, ES, PT)</li>
        <li>Escalade vers un humain si nécessaire</li>
      </ul>

      <h2>💡 Questions suggérées</h2>
      <ul>
        <li>Quels sont vos tarifs ?</li>
        <li>Comment fonctionnent les micro-agents ?</li>
        <li>Quel est le délai de déploiement ?</li>
        <li>Proposez-vous une garantie ?</li>
        <li>Je veux une démo gratuite</li>
      </ul>

      <h2>🚀 Technologie</h2>
      <p>
        <strong>Mistral AI</strong> <span class="badge">Priorité</span><br>
        Rapide et économique pour les réponses courantes
      </p>
      <p>
        <strong>Claude (Anthropic)</strong> <span class="badge">Fallback</span><br>
        Intelligence avancée pour les questions complexes
      </p>
      <p>
        <strong>RAG</strong> <span class="badge">Base de connaissances</span><br>
        Réponses précises basées sur nos données
      </p>

      <a href="/" class="back-link">← Retour à l'accueil</a>
    </div>

    <div class="chat-container">
      <div class="chat-header">
        <div class="avatar">🤖</div>
        <div class="header-info">
          <h3>Zyra</h3>
          <p>Assistante IA • <span class="status-dot"></span> En ligne</p>
        </div>
      </div>

      <div class="chat-messages" id="messages">
        <div class="message">
          <div class="message-avatar">🤖</div>
          <div class="message-content">
            Bonjour ! Je suis Zyra, votre assistante IA chez ZyatrIA Global. Comment puis-je vous aider aujourd'hui ?
          </div>
        </div>
      </div>

      <div class="chat-input-container">
        <div class="quick-actions">
          <button class="quick-action" onclick="sendQuickMessage('Quels sont vos tarifs ?')">💰 Tarifs</button>
          <button class="quick-action" onclick="sendQuickMessage('Comment fonctionnent les micro-agents ?')">🤖 Micro-agents</button>
          <button class="quick-action" onclick="sendQuickMessage('Je veux une démo')">📅 Démo</button>
          <button class="quick-action" onclick="sendQuickMessage('Quel est le délai de déploiement ?')">⏱️ Délai</button>
        </div>
        <div class="chat-input-wrapper">
          <input 
            type="text" 
            class="chat-input" 
            id="userInput" 
            placeholder="Posez votre question..."
            onkeypress="handleKeyPress(event)"
          >
          <button class="send-button" id="sendBtn" onclick="sendMessage()">
            ➤
          </button>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ baseUrl }}>
    const messages = [];
    const messagesContainer = document.getElementById('messages');
    const userInput = document.getElementById('userInput');
    const sendBtn = document.getElementById('sendBtn');

    function addMessage(role, content) {
      messages.push({ role, content });
      
      const messageDiv = document.createElement('div');
      messageDiv.className = `message ${role}`;
      
      const avatar = document.createElement('div');
      avatar.className = 'message-avatar';
      avatar.textContent = role === 'user' ? '👤' : '🤖';
      
      const contentDiv = document.createElement('div');
      contentDiv.className = 'message-content';
      contentDiv.textContent = content;
      
      messageDiv.appendChild(avatar);
      messageDiv.appendChild(contentDiv);
      messagesContainer.appendChild(messageDiv);
      
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function showTyping() {
      const typingDiv = document.createElement('div');
      typingDiv.className = 'message';
      typingDiv.id = 'typing';
      typingDiv.innerHTML = `
        <div class="message-avatar">🤖</div>
        <div class="message-content typing-indicator">
          <span></span><span></span><span></span>
        </div>
      `;
      messagesContainer.appendChild(typingDiv);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function hideTyping() {
      const typing = document.getElementById('typing');
      if (typing) typing.remove();
    }

    async function sendMessage() {
      const text = userInput.value.trim();
      if (!text) return;

      addMessage('user', text);
      userInput.value = '';
      sendBtn.disabled = true;
      showTyping();

      try {
        const response = await fetch(`${baseUrl}/api/chat`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: messages,
            lang: 'fr'
          })
        });

        const data = await response.json();
        hideTyping();
        
        if (data.reply) {
          addMessage('assistant', data.reply);
          
          // Log du modèle utilisé (pour debug)
          if (data.model) {
            console.log(`Réponse générée par: ${data.model}`);
          }
        } else {
          addMessage('assistant', "Désolée, je n'ai pas pu générer de réponse. Contactez-nous à ZyatrIA.contact@gmail.com");
        }
      } catch (error) {
        console.error('Erreur:', error);
        hideTyping();
        addMessage('assistant', "Désolée, je rencontre un problème technique. Contactez-nous à ZyatrIA.contact@gmail.com");
      } finally {
        sendBtn.disabled = false;
        userInput.focus();
      }
    }

    function sendQuickMessage(text) {
      userInput.value = text;
      sendMessage();
    }

    function handleKeyPress(event) {
      if (event.key === 'Enter') {
        sendMessage();
      }
    }

    // Focus automatique
    userInput.focus();
  </script>
</body>
</html>
