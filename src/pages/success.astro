---
import MainLayout from '../layouts/main.astro';
import { CheckCircle2, ArrowRight, Mail, Calendar } from 'lucide-react';

const seoData = {
  title: "Paiement Réussi - ZyatrIA Global",
  description: "Merci pour votre confiance ! Votre paiement a été traité avec succès.",
  ogImage: "/og-image.png"
};
---

<MainLayout 
  title={seoData.title}
  description={seoData.description}
  ogImage={seoData.ogImage}
>
  <div class="min-h-screen bg-gradient-to-b from-background to-secondary/20 flex items-center justify-center px-4 py-16">
    <div class="max-w-2xl w-full">
      <!-- Success Card -->
      <div class="bg-card rounded-2xl shadow-2xl p-8 md:p-12 text-center animate-fade-in-up">
        <!-- Success Icon -->
        <div class="flex justify-center mb-6">
          <div class="w-20 h-20 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center animate-scale-in">
            <CheckCircle2 class="w-12 h-12 text-green-600 dark:text-green-400" />
          </div>
        </div>

        <!-- Title -->
        <h1 class="text-3xl md:text-4xl font-heading font-bold text-foreground mb-4">
          🎉 Paiement Réussi !
        </h1>

        <!-- Subtitle -->
        <p class="text-lg text-muted-foreground mb-8">
          Merci pour votre confiance ! Votre paiement a été traité avec succès.
        </p>

        <!-- Divider -->
        <div class="w-24 h-1 bg-primary mx-auto mb-8 rounded-full"></div>

        <!-- Next Steps -->
        <div class="bg-secondary/50 rounded-xl p-6 mb-8 text-left">
          <h2 class="text-xl font-heading font-semibold text-foreground mb-4 flex items-center gap-2">
            <span>📋</span> Prochaines Étapes
          </h2>
          
          <div class="space-y-4">
            <!-- Step 1 -->
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center font-bold text-sm">
                1
              </div>
              <div>
                <h3 class="font-semibold text-foreground mb-1 flex items-center gap-2">
                  <Mail class="w-4 h-4" />
                  Vérifiez votre email
                </h3>
                <p class="text-sm text-muted-foreground">
                  Vous recevrez un email de confirmation avec tous les détails de votre commande dans les prochaines minutes.
                </p>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center font-bold text-sm">
                2
              </div>
              <div>
                <h3 class="font-semibold text-foreground mb-1 flex items-center gap-2">
                  <Calendar class="w-4 h-4" />
                  Rendez-vous de lancement
                </h3>
                <p class="text-sm text-muted-foreground">
                  Notre équipe vous contactera sous 24-48h pour planifier votre rendez-vous de lancement et démarrer le déploiement.
                </p>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 bg-primary text-primary-foreground rounded-full flex items-center justify-center font-bold text-sm">
                3
              </div>
              <div>
                <h3 class="font-semibold text-foreground mb-1 flex items-center gap-2">
                  <ArrowRight class="w-4 h-4" />
                  Déploiement en 7-15 jours
                </h3>
                <p class="text-sm text-muted-foreground">
                  Vos agents IA seront déployés et opérationnels dans un délai de 7 à 15 jours selon votre plan.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Contact Info -->
        <div class="bg-primary/10 border border-primary/20 rounded-xl p-6 mb-8">
          <h3 class="font-semibold text-foreground mb-2">
            💬 Besoin d'aide ?
          </h3>
          <p class="text-sm text-muted-foreground mb-3">
            Notre équipe est là pour vous accompagner à chaque étape.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a 
              href="mailto:support@zyatria.global"
              class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-colors text-sm font-medium"
            >
              <Mail class="w-4 h-4" />
              support@zyatria.global
            </a>
            <a 
              href="/#contact"
              class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-secondary text-secondary-foreground rounded-lg hover:bg-secondary/80 transition-colors text-sm font-medium"
            >
              Formulaire de contact
            </a>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-all hover:scale-105 font-semibold"
          >
            Retour à l'accueil
            <ArrowRight class="w-5 h-5" />
          </a>
          <a 
            href="/docs"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-secondary text-secondary-foreground rounded-lg hover:bg-secondary/80 transition-all hover:scale-105 font-semibold"
          >
            Documentation
          </a>
        </div>

        <!-- Social Proof -->
        <div class="mt-8 pt-8 border-t border-border">
          <p class="text-sm text-muted-foreground mb-4">
            Rejoignez plus de 150+ entreprises qui nous font confiance
          </p>
          <div class="flex justify-center gap-6 text-xs text-muted-foreground">
            <div class="text-center">
              <div class="text-2xl font-bold text-primary">98%</div>
              <div>Satisfaction</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-primary">7-15j</div>
              <div>Déploiement</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-primary">24/7</div>
              <div>Support</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Additional Info -->
      <div class="mt-8 text-center text-sm text-muted-foreground">
        <p>
          Vous avez des questions ? Consultez notre 
          <a href="/docs" class="text-primary hover:underline">documentation</a> ou 
          <a href="/#contact" class="text-primary hover:underline">contactez-nous</a>.
        </p>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes scale-in {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease-out;
  }

  .animate-scale-in {
    animation: scale-in 0.5s ease-out;
  }
</style>
