---
import MainLayout from '../layouts/main.astro';
import { Card } from '../components/ui/card';

const seoData = {
  title: "Paiement Réussi | ZyatrIA Global",
  description: "Votre paiement a été traité avec succès. Merci pour votre confiance !",
  ogImage: "/og-image.png",
};

// Récupérer le session_id depuis l'URL
const sessionId = Astro.url.searchParams.get('session_id');
---

<MainLayout 
  title={seoData.title}
  description={seoData.description}
  ogImage={seoData.ogImage}
>
  <div class="min-h-screen bg-gradient-to-b from-background to-muted/20 flex items-center justify-center">
    <div class="container-responsive py-16">
      <div class="max-w-2xl mx-auto text-center">
        {/* Icône de succès */}
        <div class="mb-8 flex justify-center">
          <div class="w-24 h-24 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center animate-scale-in">
            <svg 
              class="w-12 h-12 text-green-600 dark:text-green-400" 
              fill="none" 
              stroke="currentColor" 
              viewBox="0 0 24 24"
            >
              <path 
                stroke-linecap="round" 
                stroke-linejoin="round" 
                stroke-width="2" 
                d="M5 13l4 4L19 7"
              />
            </svg>
          </div>
        </div>

        {/* Titre */}
        <h1 class="text-responsive-3xl font-heading font-bold mb-4 animate-fade-in-up">
          Paiement Réussi ! 🎉
        </h1>

        {/* Description */}
        <p class="text-responsive-lg text-muted-foreground mb-8 animate-fade-in-up delay-100">
          Merci pour votre confiance ! Votre paiement a été traité avec succès.
        </p>

        {/* Card avec détails */}
        <div class="animate-fade-in-up delay-200">
          <Card className="p-8 bg-card">
            <div class="space-y-6">
              {/* Session ID */}
              {sessionId && (
                <div class="bg-muted/50 p-4 rounded-lg">
                  <p class="text-sm text-muted-foreground mb-2">ID de session</p>
                  <p class="text-xs font-mono break-all">{sessionId}</p>
                </div>
              )}

              {/* Prochaines étapes */}
              <div class="text-left space-y-4">
                <h2 class="text-xl font-heading font-semibold">Prochaines étapes :</h2>
                <ul class="space-y-3">
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span class="text-sm">Vous allez recevoir un email de confirmation dans quelques minutes</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span class="text-sm">Notre équipe vous contactera sous 24h pour démarrer votre projet</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <span class="text-sm">Vous recevrez vos accès et la documentation complète</span>
                  </li>
                </ul>
              </div>

              {/* Boutons d'action */}
              <div class="flex flex-col sm:flex-row gap-4 pt-6">
                <a 
                  href="/" 
                  class="flex-1 inline-flex items-center justify-center px-6 py-3 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 transition-smooth font-button"
                >
                  Retour à l'accueil
                </a>
                <a 
                  href="/contact-simple" 
                  class="flex-1 inline-flex items-center justify-center px-6 py-3 border border-input bg-background rounded-lg hover:bg-accent hover:text-accent-foreground transition-smooth font-button"
                >
                  Nous contacter
                </a>
              </div>
            </div>
          </Card>
        </div>

        {/* Message de support */}
        <p class="text-sm text-muted-foreground mt-8 animate-fade-in-up delay-300">
          Une question ? Contactez-nous à{' '}
          <a href="mailto:support@zyatria.global" class="text-primary hover:underline">
            support@zyatria.global
          </a>
        </p>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  @keyframes scale-in {
    from {
      transform: scale(0);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .animate-scale-in {
    animation: scale-in 0.5s ease-out forwards;
  }
</style>
