---
// Page de simulation Stripe pour tester les redirections
const planName = Astro.url.searchParams.get('plan') || 'Starter';
const amount = Astro.url.searchParams.get('amount') || '299';
const type = Astro.url.searchParams.get('type') || 'monthly';
const currency = 'CAD';

const typeLabel = type === 'monthly' ? 'Abonnement Mensuel' : 'Paiement Unique';
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Paiement Stripe - {planName}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #635bff 0%, #4f46e5 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .stripe-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            max-width: 500px;
            width: 100%;
            overflow: hidden;
        }
        
        .stripe-header {
            background: #635bff;
            color: white;
            padding: 30px;
            text-align: center;
        }
        
        .stripe-logo {
            font-size: 2rem;
            font-weight: bold;
            margin-bottom: 10px;
        }
        
        .stripe-subtitle {
            opacity: 0.9;
            font-size: 0.9rem;
        }
        
        .stripe-body {
            padding: 40px;
        }
        
        .plan-info {
            background: #f7fafc;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 30px;
        }
        
        .plan-name {
            font-size: 1.5rem;
            font-weight: bold;
            color: #1a202c;
            margin-bottom: 10px;
        }
        
        .plan-type {
            color: #718096;
            margin-bottom: 15px;
        }
        
        .plan-price {
            font-size: 2.5rem;
            font-weight: bold;
            color: #635bff;
        }
        
        .plan-price span {
            font-size: 1rem;
            color: #718096;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-label {
            display: block;
            font-weight: 600;
            color: #2d3748;
            margin-bottom: 8px;
            font-size: 0.9rem;
        }
        
        .form-input {
            width: 100%;
            padding: 12px;
            border: 2px solid #e2e8f0;
            border-radius: 6px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }
        
        .form-input:focus {
            outline: none;
            border-color: #635bff;
            box-shadow: 0 0 0 3px rgba(99, 91, 255, 0.1);
        }
        
        .card-element {
            background: #f7fafc;
            border: 2px solid #e2e8f0;
            border-radius: 6px;
            padding: 15px;
            margin-bottom: 20px;
        }
        
        .card-placeholder {
            color: #a0aec0;
            font-size: 0.9rem;
        }
        
        .test-card-info {
            background: #fef5e7;
            border-left: 4px solid #f39c12;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 4px;
        }
        
        .test-card-info strong {
            color: #d68910;
            display: block;
            margin-bottom: 8px;
        }
        
        .test-card-info code {
            background: white;
            padding: 2px 6px;
            border-radius: 3px;
            font-family: monospace;
            color: #2d3748;
        }
        
        .btn-pay {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #635bff 0%, #4f46e5 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .btn-pay:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(99, 91, 255, 0.3);
        }
        
        .btn-pay:active {
            transform: translateY(0);
        }
        
        .secure-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 20px;
            color: #718096;
            font-size: 0.85rem;
        }
        
        .secure-badge svg {
            width: 16px;
            height: 16px;
        }
        
        .success-message {
            display: none;
            background: #d4edda;
            border: 2px solid #c3e6cb;
            color: #155724;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            margin-top: 20px;
        }
        
        .success-message.show {
            display: block;
            animation: slideIn 0.5s ease;
        }
        
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #635bff;
            text-decoration: none;
            font-weight: 600;
        }
        
        .back-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="stripe-container">
        <div class="stripe-header">
            <div class="stripe-logo">stripe</div>
            <div class="stripe-subtitle">Paiement sécurisé</div>
        </div>
        
        <div class="stripe-body">
            <div class="plan-info">
                <div class="plan-name">{planName}</div>
                <div class="plan-type">{typeLabel}</div>
                <div class="plan-price">
                    {amount} <span>{currency}</span>
                    {type === 'monthly' && <span>/mois</span>}
                </div>
            </div>
            
            <div class="test-card-info">
                <strong>🧪 Mode Test</strong>
                Utilisez cette carte de test :<br>
                <code>4242 4242 4242 4242</code><br>
                Date : n'importe quelle date future<br>
                CVC : n'importe quel 3 chiffres
            </div>
            
            <form id="payment-form">
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input 
                        type="email" 
                        class="form-input" 
                        placeholder="client@example.com"
                        value="client@example.com"
                        required
                    />
                </div>
                
                <div class="form-group">
                    <label class="form-label">Informations de carte</label>
                    <div class="card-element">
                        <div class="card-placeholder">4242 4242 4242 4242</div>
                    </div>
                </div>
                
                <button type="submit" class="btn-pay">
                    💳 Payer {amount} {currency}
                </button>
                
                <div class="secure-badge">
                    <svg fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                    </svg>
                    Paiement sécurisé par Stripe
                </div>
            </form>
            
            <div id="success-message" class="success-message">
                <h3>✅ Paiement réussi !</h3>
                <p>Merci pour votre achat. Un email de confirmation vous a été envoyé.</p>
            </div>
            
            <a href="/" class="back-link">← Retour au site</a>
        </div>
    </div>
    
    <script>
        const form = document.getElementById('payment-form');
        const successMessage = document.getElementById('success-message');
        
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            
            // Simuler un délai de traitement
            const button = form.querySelector('button');
            button.textContent = '⏳ Traitement...';
            button.disabled = true;
            
            setTimeout(() => {
                form.style.display = 'none';
                successMessage.classList.add('show');
                
                // Rediriger après 3 secondes
                setTimeout(() => {
                    window.location.href = '/success';
                }, 3000);
            }, 2000);
        });
    </script>
</body>
</html>
