---
import MainLayout from '../layouts/main.astro';

const seoData = {
  title: "Démo Interactive - Agent IA Multicanal | ZyatrIA Global",
  description: "Testez notre agent IA en direct ! Chat, email, appels - Propulsé par Mistral AI. Réponses intelligentes en temps réel.",
  ogImage: "/og-image.png",
};
---

<MainLayout 
  title={seoData.title}
  description={seoData.description}
  ogImage={seoData.ogImage}
>
  <div class="min-h-screen bg-gradient-to-br from-background via-muted/30 to-background py-20">
    <div class="container mx-auto px-4">
      <!-- Header -->
      <div class="text-center mb-12 animate-fade-in-up">
        <div class="inline-block mb-4">
          <span class="bg-primary/10 text-primary px-4 py-2 rounded-full text-sm font-semibold">
            🤖 Démo Interactive
          </span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-primary via-primary/80 to-primary bg-clip-text text-transparent">
          Testez Notre Agent IA en Direct
        </h1>
        <p class="text-xl text-muted-foreground max-w-3xl mx-auto">
          Découvrez la puissance de nos agents IA multicanaux. Chat, email, appels - tout est géré intelligemment par Mistral AI.
        </p>
      </div>

      <!-- Stats rapides -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12 animate-fade-in-up delay-200">
        <div class="bg-card border border-border rounded-lg p-6 text-center">
          <div class="text-3xl font-bold text-primary mb-2">< 3s</div>
          <div class="text-sm text-muted-foreground">Temps de réponse moyen</div>
        </div>
        <div class="bg-card border border-border rounded-lg p-6 text-center">
          <div class="text-3xl font-bold text-primary mb-2">24/7</div>
          <div class="text-sm text-muted-foreground">Disponibilité</div>
        </div>
        <div class="bg-card border border-border rounded-lg p-6 text-center">
          <div class="text-3xl font-bold text-primary mb-2">95%+</div>
          <div class="text-sm text-muted-foreground">Précision des réponses</div>
        </div>
      </div>

      <!-- Demo Component -->
      <div class="animate-fade-in-up delay-300">
        <div id="demo-app"></div>
      </div>

      <!-- Features -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 animate-fade-in-up delay-400">
        <div class="bg-card border border-border rounded-lg p-6">
          <div class="text-3xl mb-4">💬</div>
          <h3 class="text-xl font-semibold mb-2">Chat en Temps Réel</h3>
          <p class="text-muted-foreground">
            Conversations fluides et naturelles avec analyse d'intention automatique.
          </p>
        </div>
        <div class="bg-card border border-border rounded-lg p-6">
          <div class="text-3xl mb-4">📧</div>
          <h3 class="text-xl font-semibold mb-2">Emails Professionnels</h3>
          <p class="text-muted-foreground">
            Réponses email structurées et personnalisées selon le contexte.
          </p>
        </div>
        <div class="bg-card border border-border rounded-lg p-6">
          <div class="text-3xl mb-4">📞</div>
          <h3 class="text-xl font-semibold mb-2">Appels Vocaux</h3>
          <p class="text-muted-foreground">
            Transcription et réponses intelligentes pour vos appels clients.
          </p>
        </div>
        <div class="bg-card border border-border rounded-lg p-6">
          <div class="text-3xl mb-4">🎯</div>
          <h3 class="text-xl font-semibold mb-2">Détection d'Intention</h3>
          <p class="text-muted-foreground">
            Classification automatique : info, réclamation, commande, urgent.
          </p>
        </div>
        <div class="bg-card border border-border rounded-lg p-6">
          <div class="text-3xl mb-4">🌍</div>
          <h3 class="text-xl font-semibold mb-2">Multilingue</h3>
          <p class="text-muted-foreground">
            Support en français, anglais, espagnol et portugais.
          </p>
        </div>
        <div class="bg-card border border-border rounded-lg p-6">
          <div class="text-3xl mb-4">🔒</div>
          <h3 class="text-xl font-semibold mb-2">Sécurisé</h3>
          <p class="text-muted-foreground">
            Données chiffrées et conformité RGPD garantie.
          </p>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-16 text-center bg-gradient-to-r from-primary/10 via-primary/5 to-primary/10 rounded-2xl p-12 animate-fade-in-up delay-500">
        <h2 class="text-3xl font-bold mb-4">Impressionné par la Démo ?</h2>
        <p class="text-xl text-muted-foreground mb-8 max-w-2xl mx-auto">
          Imaginez ce que nos agents IA peuvent faire pour votre entreprise. Déploiement en 7-15 jours.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/contact-simple" 
            class="inline-flex items-center justify-center px-8 py-4 bg-primary text-primary-foreground rounded-lg font-semibold hover:bg-primary/90 transition-all hover-lift"
          >
            Réserver une Consultation Gratuite
          </a>
          <a 
            href="/pricing" 
            class="inline-flex items-center justify-center px-8 py-4 bg-card border-2 border-primary text-primary rounded-lg font-semibold hover:bg-primary/10 transition-all"
          >
            Voir les Tarifs
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import { createRoot } from 'react-dom/client';
  import { createElement } from 'react';
  import DemoPage from '../components/pages/DemoPage';

  const container = document.getElementById('demo-app');
  if (container) {
    const root = createRoot(container);
    root.render(createElement(DemoPage));
  }
</script>
