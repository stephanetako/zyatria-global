---
import MainLayout from '../layouts/main.astro';
import SimpleContactForm from '../components/SimpleContactForm';

const seoData = {
  title: "Contact Simple - ZyatrIA Global",
  description: "Contactez-nous via notre formulaire simplifié. Réponse garantie sous 24h.",
  ogImage: "/og-image.png"
};
---

<MainLayout 
  title={seoData.title}
  description={seoData.description}
  ogImage={seoData.ogImage}
>
  <div class="min-h-screen bg-gradient-to-b from-background to-muted/20">
    <!-- Header Section -->
    <section class="section-spacing-sm border-b border-border/50">
      <div class="container-responsive max-w-4xl mx-auto text-center">
        <h1 class="text-responsive-3xl font-bold mb-4 bg-gradient-to-r from-primary to-primary/60 bg-clip-text text-transparent">
          Parlons de votre projet
        </h1>
        <p class="text-responsive-lg text-muted-foreground max-w-2xl mx-auto">
          Notre équipe d'experts est prête à transformer vos idées en solutions IA concrètes
        </p>
      </div>
    </section>

    <!-- Form Section -->
    <section class="section-spacing">
      <div class="container-responsive">
        <SimpleContactForm client:load />
      </div>
    </section>

    <!-- Info Section -->
    <section class="section-spacing-sm bg-muted/30">
      <div class="container-responsive max-w-4xl mx-auto">
        <div class="grid md:grid-cols-3 gap-8 text-center">
          <div class="space-y-2">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Réponse rapide</h3>
            <p class="text-sm text-muted-foreground">
              Nous répondons à tous les messages dans les 24 heures ouvrables
            </p>
          </div>

          <div class="space-y-2">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Confidentialité</h3>
            <p class="text-sm text-muted-foreground">
              Vos informations sont sécurisées et ne seront jamais partagées
            </p>
          </div>

          <div class="space-y-2">
            <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
            <h3 class="font-semibold text-lg">Support multilingue</h3>
            <p class="text-sm text-muted-foreground">
              Nous communiquons en français, anglais, espagnol et portugais
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Alternative Contact Methods -->
    <section class="section-spacing-sm">
      <div class="container-responsive max-w-4xl mx-auto text-center">
        <h2 class="text-2xl font-bold mb-6">Autres moyens de nous contacter</h2>
        <div class="flex flex-wrap justify-center gap-4">
          <a 
            href="mailto:contact@zyatria.global" 
            class="inline-flex items-center gap-2 px-6 py-3 bg-secondary hover:bg-secondary/80 rounded-lg transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            contact@zyatria.global
          </a>
          
          <a 
            href="tel:+15551234567" 
            class="inline-flex items-center gap-2 px-6 py-3 bg-secondary hover:bg-secondary/80 rounded-lg transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            +1 (555) 123-4567
          </a>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  /* Animations pour les cartes */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  section {
    animation: fade-in-up 0.6s ease-out;
  }
</style>
