---
import MainLayout from '../layouts/main.astro';
import PricingPage from '../components/pages/PricingPage';

const seoData = {
  title: "Pricing | ZyatrIA Global - AI Agents & Automation",
  description: "Transparent pricing for AI agents and automation solutions. Choose the plan that fits your business needs. Deploy in 7-15 days.",
  ogImage: "/og-image.svg"
