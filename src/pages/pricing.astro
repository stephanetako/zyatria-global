



---
import MainLayout from '../layouts/main.astro';
import Navigation from '../components/Navigation';
import Pricing from '../components/Pricing';
import Footer from '../components/Footer';
import FormspreeButton from '../components/FormspreeButton';

const seoData = {
  title: "Tarifs Agents IA | Plans Starter, Business & Enterprise | À partir de 49€/mois | ZyatrIA",
  description: "Découvrez nos forfaits d'agents IA : Starter à 49€/mois (1 micro-agent), Business à 149€/mois (3 micro-agents + automatisations), Enterprise sur-mesure. Support multilingue, déploiement en 7-15 jours. Tarification transparente en EUR, USD, CAD.",
  ogImage: "/og-image-pricing.jpg",
  keywords: "tarifs agents IA, prix micro-agents, forfait IA entreprise, abonnement agent intelligent, coût automatisation IA, pricing transparent"
};
---

<MainLayout 
  title={seoData.title}
  description={seoData.description}
  ogImage={seoData.ogImage}
>
<div class="relative">
<Navigation client:load />
<Pricing client:only="react" />
<Footer client:only="react" />
<FormspreeButton client:only="react" />
</div>
</MainLayout>





