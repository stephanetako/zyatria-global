
---
import MainLayout from '../layouts/main.astro';
import LeadQualificationForm from '../components/LeadQualificationForm';
import SimpleContactForm from '../components/SimpleContactForm';
import CompactContactForm from '../components/CompactContactForm';
---

<MainLayout title="Test Formspree - ZyatrIA">
  <div class="min-h-screen bg-background py-12">
    <div class="container mx-auto px-4 space-y-12">
      <!-- Header -->
      <div class="text-center space-y-4">
        <h1 class="text-4xl font-bold">Test Formspree</h1>
        <p class="text-muted-foreground">
          Testez tous les formulaires avec le hook officiel @formspree/react
        </p>
        <div class="bg-blue-50 dark:bg-blue-900/20 p-4 rounded-lg max-w-2xl mx-auto">
          <p class="text-sm">
            <strong>Form ID:</strong> xbdedonn<br />
            <strong>Endpoint:</strong> https://formspree.io/f/xbdedonn<br />
            <strong>Méthode:</strong> Hook officiel @formspree/react
          </p>
        </div>
      </div>

      <!-- Lead Qualification Form -->
      <section class="space-y-4">
        <div class="text-center">
          <h2 class="text-2xl font-bold">1. Lead Qualification Form</h2>
          <p class="text-muted-foreground">Formulaire complet avec tous les champs</p>
        </div>
        <LeadQualificationForm client:only="react" />
      </section>

      <hr class="my-12" />

      <!-- Simple Contact Form -->
      <section class="space-y-4">
        <div class="text-center">
          <h2 class="text-2xl font-bold">2. Simple Contact Form</h2>
          <p class="text-muted-foreground">Formulaire de contact basique</p>
        </div>
        <SimpleContactForm client:only="react" />
      </section>

      <hr class="my-12" />

      <!-- Compact Contact Form -->
      <section class="space-y-4">
        <div class="text-center">
          <h2 class="text-2xl font-bold">3. Compact Contact Form</h2>
          <p class="text-muted-foreground">Formulaire compact sans labels</p>
        </div>
        <div class="max-w-md mx-auto">
          <CompactContactForm client:only="react" />
        </div>
      </section>

      <!-- Instructions -->
      <section class="bg-yellow-50 dark:bg-yellow-900/20 p-6 rounded-lg max-w-2xl mx-auto">
        <h3 class="text-xl font-bold mb-4">📋 Instructions de Test</h3>
        <ol class="list-decimal list-inside space-y-2 text-sm">
          <li>Ouvrez la console du navigateur (F12)</li>
          <li>Remplissez un des formulaires ci-dessus</li>
          <li>Cliquez sur "Envoyer"</li>
          <li>Vérifiez les logs dans la console</li>
          <li>Vérifiez votre dashboard Formspree pour la soumission</li>
        </ol>
      </section>

      <!-- Debug Info -->
      <section class="bg-gray-50 dark:bg-gray-900/20 p-6 rounded-lg max-w-2xl mx-auto">
        <h3 class="text-xl font-bold mb-4">🔍 Debug Info</h3>
        <div class="space-y-2 text-sm font-mono">
          <p><strong>Package:</strong> @formspree/react v3.0.0</p>
          <p><strong>Hook:</strong> useForm('xbdedonn')</p>
          <p><strong>Validation:</strong> ValidationError component</p>
          <p><strong>Success:</strong> state.succeeded</p>
          <p><strong>Submitting:</strong> state.submitting</p>
          <p><strong>Errors:</strong> state.errors</p>
        </div>
      </section>
    </div>
  </div>
</MainLayout>

<style>
  /* Ensure proper spacing and readability */
  section {
    scroll-margin-top: 2rem;
  }
</style>

