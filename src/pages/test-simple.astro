
---
import MainLayout from '../layouts/main.astro';
---

<MainLayout title="Test Simple - ZyatrIA">
  <div class="min-h-screen bg-gradient-to-br from-[#F5F1EB] via-[#E6DCD4] to-[#D9A88F] flex items-center justify-center p-8">
    <div class="max-w-4xl mx-auto text-center text-[#373D36]">
      <h1 class="text-6xl font-bold mb-6">
        ✅ Ça Fonctionne !
      </h1>
      
      <p class="text-2xl mb-8 opacity-90">
        Si tu vois cette page, ton site Astro est opérationnel.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white/50 backdrop-blur-sm p-6 rounded-xl border border-[#C98769]/30">
          <div class="text-4xl font-bold mb-2">✅</div>
          <div class="text-lg">Astro OK</div>
        </div>
        <div class="bg-white/50 backdrop-blur-sm p-6 rounded-xl border border-[#C98769]/30">
          <div class="text-4xl font-bold mb-2">✅</div>
          <div class="text-lg">Tailwind OK</div>
        </div>
        <div class="bg-white/50 backdrop-blur-sm p-6 rounded-xl border border-[#C98769]/30">
          <div class="text-4xl font-bold mb-2">✅</div>
          <div class="text-lg">Layout OK</div>
        </div>
      </div>

      <div class="space-y-4">
        <a 
          href="/" 
          class="inline-block px-8 py-4 bg-[#C98769] text-white font-semibold rounded-lg hover:bg-[#A86F53] transition shadow-lg shadow-[#C98769]/30"
        >
          Retour à l'accueil
        </a>
        <br />
        <a 
          href="/diagnostic" 
          class="inline-block px-8 py-4 bg-white/30 backdrop-blur-sm text-[#373D36] font-semibold rounded-lg hover:bg-white/50 transition border border-[#C98769]/30"
        >
          Page de diagnostic
        </a>
      </div>
    </div>
  </div>

  <script>
    console.log('✅ Test simple page loaded!');
    console.log('🎯 If you see this, JavaScript is working');
    console.log('📍 Current URL:', window.location.href);
  </script>
</MainLayout>

