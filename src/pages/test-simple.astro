
---
import MainLayout from '../layouts/main.astro';
---

<MainLayout title="Test Simple">
  <div style="padding: 40px; text-align: center;">
    <h1 style="font-size: 3rem; color: #667eea; margin-bottom: 20px;">
      ✅ Le site fonctionne !
    </h1>
    <p style="font-size: 1.5rem; color: #333; margin-bottom: 30px;">
      Si vous voyez ce texte avec des couleurs, le serveur Astro fonctionne parfaitement.
    </p>
    
    <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; border-radius: 15px; max-width: 600px; margin: 0 auto;">
      <h2 style="font-size: 2rem; margin-bottom: 15px;">🎯 Diagnostic</h2>
      <ul style="text-align: left; font-size: 1.1rem; line-height: 2;">
        <li>✓ Serveur Astro : OK</li>
        <li>✓ HTML : OK</li>
        <li>✓ CSS : OK</li>
        <li id="react-status">⏳ React : Vérification...</li>
      </ul>
    </div>
    
    <div id="react-test" style="margin-top: 30px;"></div>
  </div>
  
  <script>
    // Test React
    const reactTest = document.getElementById('react-test');
    const reactStatus = document.getElementById('react-status');
    
    setTimeout(() => {
      const islands = document.querySelectorAll('astro-island');
      if (islands.length > 0) {
        if (reactStatus) {
          reactStatus.textContent = '✓ React : ' + islands.length + ' composants détectés';
          reactStatus.style.color = '#10b981';
        }
        
        // Vérifier si les composants sont hydratés
        setTimeout(() => {
          const hasContent = Array.from(islands).some(island => island.innerHTML.trim().length > 100);
          if (reactTest) {
            if (hasContent) {
              reactTest.innerHTML = '<p style="color: #10b981; font-size: 1.2rem;">✅ Les composants React sont chargés et fonctionnent !</p>';
            } else {
              reactTest.innerHTML = '<p style="color: #ef4444; font-size: 1.2rem;">❌ Les composants React ne s\'hydratent pas. Vérifiez la console du navigateur.</p>';
            }
          }
        }, 2000);
      } else {
        if (reactStatus) {
          reactStatus.textContent = '✗ React : Aucun composant détecté';
          reactStatus.style.color = '#ef4444';
        }
      }
    }, 500);
  </script>
</MainLayout>

