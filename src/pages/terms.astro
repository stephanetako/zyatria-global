---
import MainLayout from '../layouts/main.astro';
import Navigation from '../components/Navigation';
import Footer from '../components/Footer';

const seoData = {
  title: "Terms of Service | ZyatrIA Global - AI Agents & Automation",
  description: "Terms of service and conditions for using ZyatrIA Global's AI agents and automation services.",
  ogImage: "/og-image.svg"
};
---

<MainLayout 
  title={seoData.title}
  description={seoData.description}
  ogImage={seoData.ogImage}
>
  <Navigation client:load />
  
  <main class="min-h-screen bg-background pt-24 pb-16">
    <div class="container-responsive max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-foreground mb-4">
          Terms of Service
        </h1>
        <p class="text-muted-foreground text-lg">
          Last updated: {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </p>
      </div>

      <!-- Content -->
      <div class="prose prose-lg max-w-none">
        <div class="bg-card rounded-lg p-8 mb-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">1. Agreement to Terms</h2>
          <p class="text-muted-foreground mb-4">
            By accessing or using ZyatrIA Global's services ("Services"), you agree to be bound by these Terms of Service ("Terms"). If you do not agree to these Terms, please do not use our Services.
          </p>
          <p class="text-muted-foreground">
            These Terms constitute a legally binding agreement between you (either an individual or entity) and ZyatrIA Global, a Canadian company based in Quebec.
          </p>
        </div>

        <div class="bg-card rounded-lg p-8 mb-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">2. Services Description</h2>
          <p class="text-muted-foreground mb-4">
            ZyatrIA Global provides the following services:
          </p>
          <ul class="list-disc pl-6 text-muted-foreground space-y-2">
            <li><strong>Intelligent AI Agents:</strong> Custom AI solutions for business automation</li>
            <li><strong>Advanced Automation:</strong> Workflow optimization and process automation</li>
            <li><strong>Micro-Agents:</strong> Specialized AI agents for specific business functions</li>
            <li><strong>Consulting and Support:</strong> Implementation, training, and ongoing support</li>
          </ul>
        </div>

        <div class="bg-card rounded-lg p-8 mb-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">3. Subscription Plans</h2>
          
          <h3 class="text-xl font-semibold mb-3 mt-6">3.1 Plans Available</h3>
          <ul class="list-disc pl-6 text-muted-foreground space-y-3">
            <li><strong>Starter Plan:</strong> 69 CAD/month - 1 AI micro-agent, 24/7 responses, email support</li>
            <li><strong>Business Plan:</strong> 169 CAD/month - 3 AI micro-agents, advanced automation, CRM integration, priority support</li>
            <li><strong>Enterprise Plan:</strong> 500 CAD/month - Custom AI agents, complete automation, dedicated support</li>
          </ul>

          <h3 class="text-xl font-semibold mb-3 mt-6">3.2 Free Trial</h3>
          <p class="text-muted-foreground">
            All plans include a 7-day free trial. You will not be charged until the trial period ends. You may cancel anytime during the trial without charge.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">3.3 Billing</h3>
          <p class="text-muted-foreground mb-4">
            Subscriptions are billed monthly in Canadian dollars (CAD). Payments are processed securely through Stripe. By subscribing, you authorize us to charge your payment method on a recurring basis.
          </p>
        </div>

        <div class="bg-card rounded-lg p-8 mb-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">4. Payment Terms</h2>
          
          <h3 class="text-xl font-semibold mb-3 mt-6">4.1 Payment Processing</h3>
          <p class="text-muted-foreground mb-4">
            All payments are processed by Stripe, Inc. We do not store your payment card information. Stripe's terms and privacy policy apply to all transactions.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">4.2 Automatic Renewal</h3>
          <p class="text-muted-foreground mb-4">
            Your subscription will automatically renew at the end of each billing period unless you cancel before the renewal date.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">4.3 Price Changes</h3>
          <p class="text-muted-foreground mb-4">
            We reserve the right to modify subscription prices. We will provide at least 30 days' notice before any price increase. Continued use of the Services after the price change constitutes acceptance.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">4.4 Refunds</h3>
          <p class="text-muted-foreground">
            Refunds are provided on a case-by-case basis. If you cancel during the free trial, you will not be charged. For paid subscriptions, please contact us to discuss refund eligibility.
          </p>
        </div>

        <div class="bg-card rounded-lg p-8 mb-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">5. Cancellation and Termination</h2>
          
          <h3 class="text-xl font-semibold mb-3 mt-6">5.1 Your Right to Cancel</h3>
          <p class="text-muted-foreground mb-4">
            You may cancel your subscription at any time through your account settings or by contacting us. Cancellation takes effect at the end of the current billing period.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">5.2 Our Right to Terminate</h3>
          <p class="text-muted-foreground mb-4">
            We may suspend or terminate your access to the Services if you:
          </p>
          <ul class="list-disc pl-6 text-muted-foreground space-y-2">
            <li>Violate these Terms</li>
            <li>Engage in fraudulent activity</li>
            <li>Fail to pay fees when due</li>
            <li>Use the Services in a manner that harms us or others</li>
          </ul>

          <h3 class="text-xl font-semibold mb-3 mt-6">5.3 Effect of Termination</h3>
          <p class="text-muted-foreground">
            Upon termination, your right to use the Services ceases immediately. We may delete your data in accordance with our data retention policy.
          </p>
        </div>

        <div class="bg-card rounded-lg p-8 mb-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">6. User Responsibilities</h2>
          <p class="text-muted-foreground mb-4">You agree to:</p>
          <ul class="list-disc pl-6 text-muted-foreground space-y-2">
            <li>Provide accurate and complete information</li>
            <li>Maintain the security of your account credentials</li>
            <li>Use the Services in compliance with applicable laws</li>
            <li>Not interfere with or disrupt the Services</li>
            <li>Not attempt to gain unauthorized access to our systems</li>
            <li>Not use the Services for illegal or harmful purposes</li>
            <li>Not resell or redistribute the Services without permission</li>
          </ul>
        </div>

        <div class="bg-card rounded-lg p-8 mb-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">7. Intellectual Property</h2>
          
          <h3 class="text-xl font-semibold mb-3 mt-6">7.1 Our Property</h3>
          <p class="text-muted-foreground mb-4">
            All content, features, and functionality of the Services, including but not limited to text, graphics, logos, software, and AI models, are owned by ZyatrIA Global and protected by copyright, trademark, and other intellectual property laws.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">7.2 Your Data</h3>
          <p class="text-muted-foreground mb-4">
            You retain all rights to data you provide to the Services. By using the Services, you grant us a limited license to use your data solely to provide the Services.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">7.3 Feedback</h3>
          <p class="text-muted-foreground">
            If you provide feedback or suggestions, we may use them without obligation to you.
          </p>
        </div>

        <div class="bg-card rounded-lg p-8 mb-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">8. Service Level and Availability</h2>
          
          <h3 class="text-xl font-semibold mb-3 mt-6">8.1 Uptime</h3>
          <p class="text-muted-foreground mb-4">
            We strive to maintain 99.9% uptime but do not guarantee uninterrupted access. The Services may be temporarily unavailable for maintenance, updates, or due to factors beyond our control.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">8.2 Support</h3>
          <p class="text-muted-foreground">
            Support availability varies by plan:
          </p>
          <ul class="list-disc pl-6 text-muted-foreground space-y-2 mt-4">
            <li><strong>Starter:</strong> Email support (48-hour response time)</li>
            <li><strong>Business:</strong> Priority email support (24-hour response time)</li>
            <li><strong>Enterprise:</strong> Dedicated support with direct contact</li>
          </ul>
        </div>

        <div class="bg-card rounded-lg p-8 mb-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">9. Disclaimers and Limitations of Liability</h2>
          
          <h3 class="text-xl font-semibold mb-3 mt-6">9.1 Service "As Is"</h3>
          <p class="text-muted-foreground mb-4">
            The Services are provided "as is" without warranties of any kind, either express or implied. We do not warrant that the Services will meet your requirements or be error-free.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">9.2 AI Limitations</h3>
          <p class="text-muted-foreground mb-4">
            AI agents may produce unexpected or inaccurate results. You are responsible for reviewing and validating AI-generated outputs before use in critical applications.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">9.3 Limitation of Liability</h3>
          <p class="text-muted-foreground">
            To the maximum extent permitted by law, ZyatrIA Global shall not be liable for any indirect, incidental, special, consequential, or punitive damages, or any loss of profits or revenues, whether incurred directly or indirectly.
          </p>
          <p class="text-muted-foreground mt-4">
            Our total liability shall not exceed the amount you paid us in the 12 months preceding the claim.
          </p>
        </div>

        <div class="bg-card rounded-lg p-8 mb-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">10. Indemnification</h2>
          <p class="text-muted-foreground">
            You agree to indemnify and hold harmless ZyatrIA Global from any claims, damages, losses, liabilities, and expenses arising from:
          </p>
          <ul class="list-disc pl-6 text-muted-foreground space-y-2 mt-4">
            <li>Your use of the Services</li>
            <li>Your violation of these Terms</li>
            <li>Your violation of any rights of another party</li>
            <li>Your data or content</li>
          </ul>
        </div>

        <div class="bg-card rounded-lg p-8 mb-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">11. Governing Law and Dispute Resolution</h2>
          
          <h3 class="text-xl font-semibold mb-3 mt-6">11.1 Governing Law</h3>
          <p class="text-muted-foreground mb-4">
            These Terms are governed by the laws of the Province of Quebec and the federal laws of Canada applicable therein.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">11.2 Dispute Resolution</h3>
          <p class="text-muted-foreground mb-4">
            Any disputes shall first be resolved through good-faith negotiation. If negotiation fails, disputes shall be resolved through arbitration in Quebec, Canada.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">11.3 Class Action Waiver</h3>
          <p class="text-muted-foreground">
            You agree to resolve disputes on an individual basis and waive the right to participate in class actions.
          </p>
        </div>

        <div class="bg-card rounded-lg p-8 mb-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">12. Changes to Terms</h2>
          <p class="text-muted-foreground mb-4">
            We may modify these Terms at any time. We will notify you of material changes by:
          </p>
          <ul class="list-disc pl-6 text-muted-foreground space-y-2">
            <li>Posting updated Terms on our website</li>
            <li>Updating the "Last updated" date</li>
            <li>Sending email notification (for significant changes)</li>
          </ul>
          <p class="text-muted-foreground mt-4">
            Continued use of the Services after changes constitutes acceptance of the modified Terms.
          </p>
        </div>

        <div class="bg-card rounded-lg p-8 mb-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">13. Miscellaneous</h2>
          
          <h3 class="text-xl font-semibold mb-3 mt-6">13.1 Entire Agreement</h3>
          <p class="text-muted-foreground mb-4">
            These Terms constitute the entire agreement between you and ZyatrIA Global regarding the Services.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">13.2 Severability</h3>
          <p class="text-muted-foreground mb-4">
            If any provision of these Terms is found invalid, the remaining provisions remain in effect.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">13.3 No Waiver</h3>
          <p class="text-muted-foreground mb-4">
            Our failure to enforce any right or provision does not constitute a waiver of that right.
          </p>

          <h3 class="text-xl font-semibold mb-3 mt-6">13.4 Assignment</h3>
          <p class="text-muted-foreground">
            You may not assign these Terms without our consent. We may assign these Terms without restriction.
          </p>
        </div>

        <div class="bg-card rounded-lg p-8 border border-border">
          <h2 class="text-2xl font-semibold mb-4">14. Contact Information</h2>
          <p class="text-muted-foreground mb-4">
            For questions about these Terms, contact us:
          </p>
          <div class="space-y-2 text-muted-foreground">
            <p><strong>Email:</strong> <a href="mailto:legal@zyatria.global" class="text-primary hover:underline">legal@zyatria.global</a></p>
            <p><strong>General inquiries:</strong> <a href="mailto:contact@zyatria.global" class="text-primary hover:underline">contact@zyatria.global</a></p>
            <p><strong>Phone:</strong> +1 (555) 123-4567</p>
            <p><strong>Address:</strong> ZyatrIA Global, Quebec, Canada</p>
          </div>
        </div>

        <div class="mt-8 p-6 bg-primary/10 border border-primary/20 rounded-lg">
          <p class="text-sm text-foreground">
            <strong>Important:</strong> By clicking "I Agree" or using our Services, you acknowledge that you have read, understood, and agree to be bound by these Terms of Service.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer client:only="react" />
</MainLayout>

<style>
  .prose {
    color: hsl(var(--foreground));
  }
  
  .prose a {
    color: hsl(var(--primary));
    text-decoration: none;
  }
  
  .prose a:hover {
    text-decoration: underline;
  }
  
  .prose h2, .prose h3 {
    color: hsl(var(--foreground));
  }
</style>
