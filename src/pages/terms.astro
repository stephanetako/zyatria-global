<!DOCTYPE html>
<html lang="fr" class="zx">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Conditions d'utilisation - ZyatrIA Global</title>
